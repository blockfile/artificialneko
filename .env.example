# ── Server ───────────────────────────────────────────────────────────────────
# The PUBLIC API (server.js). nginx proxies api.artificialneko.com to this port.
PORT=3000

# The BOT's operator API (bot.js). Bound to 127.0.0.1 — never proxy this from
# nginx: POST /run pays real money out.
BOT_PORT=3100

# ── Token ────────────────────────────────────────────────────────────────────
# NEKO's contract address on Robinhood Chain (launches on the Pons V2
# launchpad, paired with NVDA). Blank until launch ("CA coming soon") — every
# stat then answers null, which the site renders as "—" rather than a zero, and
# the rewards feed answers an empty page.
TOKEN_ADDRESS=
# Ticker without the "$" — the site shows it as $NEKO.
TOKEN_SYMBOL=NEKO
TOKEN_NAME=Artificial Neko
# Whole-token total supply and decimals. Keeps the pre-graduation market cap
# alive when Blockscout (the normal source) is unreachable, and is what DRY_RUN
# uses in place of an on-chain decimals() call. Pons V2 launches mint
# 1,000,000,000 at 18 decimals; blank disables the market-cap fallback.
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_DECIMALS=18

# ── Upstreams (no API keys needed) ───────────────────────────────────────────
# Blockscout instance for Robinhood Chain — source of the holder count and of
# the holder snapshot the airdrop is computed from.
EXPLORER_API=https://robinhoodchain.blockscout.com
# DexScreener's slug for the chain — source of the market cap and NVDA/USD.
DEXSCREENER_CHAIN_ID=robinhood
# Pons. STILL REQUIRED even though this bot does its own distributing: the
# bonding-curve chart endpoint here is what prices NEKO before it graduates.
PONS_API=https://www.ponsfamily.com
# JSON-RPC for the bot's chain reads and writes.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# ── Reward asset ─────────────────────────────────────────────────────────────
# NVDA (tokenized SpaceX stock) — the launch's QUOTE asset and therefore the
# REWARD asset. One address, both roles: fees accrue in it because NEKO is
# priced in it, and it is what holders are paid. There is deliberately no second
# "quote token" key, so the two can never drift apart.
QUOTE_DECIMALS=18

# ── Bot: wallet ──────────────────────────────────────────────────────────────
# MUST be NEKO's creatorFeeRecipient — the only address allowed to sweep or
# claim. Read by bot.js ONLY; server.js never loads it. If this is wrong the bot
# runs without a single error and silently collects nothing, forever.
#
# For this deployment that is the DEV/CREATOR wallet: launch connected as it and
# leave pons's "Creator wallet" field blank, and it becomes the recipient.
#
# Note what this key can do, since it lives on an internet-facing box: besides
# spending whatever the wallet holds, it can call transferCreatorFeeRecipient
# and permanently redirect the fee stream. Only the CURRENT recipient may
# reassign it, so nothing you hold elsewhere can undo that. chmod 600 this file
# and keep the server tight.
#
# ALSO: leave Pons's "route creator fees to holders" toggle OFF. Switching it on
# reassigns creatorFeeRecipient to a fee-distributor contract, and this bot
# instantly has nothing to claim. The two mechanisms are mutually exclusive.
#
# Blank is fine while DRY_RUN=true — an ephemeral wallet stands in.
WALLET_PRIVATE_KEY=

# DRY_RUN=true simulates every on-chain call: no funds move, no RPC is needed,
# and a simulated fee vault stands in for the escrow. Set to false ONLY after a
# funded wallet is configured and `npm run check` looks right.
DRY_RUN=true

# ── Bot: trigger ─────────────────────────────────────────────────────────────
# accumulation -> claim once the accrued NVDA is worth CLAIM_EVERY_USD
# interval     -> claim whatever has accrued on every tick
#
# The gate is in USD, not tokens: NVDA is worth hundreds of dollars, so a token
# threshold is unusable. If the NVDA price is briefly unavailable the bot HOLDS
# rather than claiming blind — the fees keep accruing for the next tick.
TRIGGER_MODE=accumulation
CLAIM_EVERY_USD=100

# Two schedules, because a poll does two jobs and they want opposite cadences.
#
# POLL_SCHEDULE reads the chain and writes the fee gauge the site renders. It
# NEVER pays anything out, so it is free to run often — the site's tank climbs
# once a minute instead of sitting frozen between distributions.
#
# TRIGGER_SCHEDULE is when a distribution may actually happen. Both conditions
# have to hold: the schedule comes round AND the claimable fees are worth
# CLAIM_EVERY_USD. If the hour arrives and the tank is short, nothing is claimed
# and the check rolls over — the fees are not lost, they keep accruing.
#
#   0 * * * *      hourly, on the hour  (default)
#   */30 * * * *   every 30 minutes, at :00 and :30
#   */20 * * * *   every 20 minutes, at :00, :20 and :40
#   */5 * * * *    every 5 minutes — the old behaviour, pays as soon as $100 lands
#
# Prefer a divisor of 60. Cron's step operator restarts at the top of each hour,
# so */45 fires at :00 and :45 and then jumps back to :00 — a 45-minute gap
# followed by a 15-minute one, not "every 45 minutes".
POLL_SCHEDULE=* * * * *
TRIGGER_SCHEDULE=0 * * * *
# DRY_RUN only: simulated NVDA accrued to the vault per tick.
DRY_RUN_FEE_PER_POLL=0.05

# ── Bot: split and eligibility ───────────────────────────────────────────────
# Each claim splits three ways. REWARD_PCT and BURN_PCT are set here; the dev
# cut is WHATEVER IS LEFT, so at the default 80/20 there is none at all and
# every NVDA collected goes back to holders or into the buyback.
#
#   REWARD_PCT  airdropped to NEKO holders, pro-rata
#   BURN_PCT    used to BUY NEKO, which is then burned (supply drops)
#   GAS_PCT     sold for native ETH so the bot can pay its own gas
#   remainder   the dev cut (see DEV_PAYOUT_ADDRESS)
#
# The three together may not exceed 100; the bot refuses to start if they do.

# The NVDA/ETH Uniswap v4 pool the gas swap routes through. NOT the pons launch
# pool — NVDA is a tokenized equity with its own markets, so this key is
# configured. Defaults are the pool verified on chain 2026-08-30: poolId
# 0x39910df8…, ~$103k liquidity, quoting 0.07 NVDA -> 0.00397 ETH.
GAS_POOL_TICK_SPACING=200
GAS_POOL_HOOKS=0x0000000000000000000000000000000000000000

# Stop converting once the wallet holds this much ETH, so the bot does not sell
# NVDA for gas it will never spend. 0 disables the ceiling — always swap.
GAS_CEILING_ETH=0

# Slippage tolerance for the buyback swap, percent. Only the buyback swaps —
# the reward leg pays out the NVDA it claimed, untouched.
SLIPPAGE_PCT=5

# Cold address that receives the dev cut at the end of every cycle.
#
# An ADDRESS, never a key — this wallet only receives, so its key can stay in a
# hardware wallet and never touch the server. That is the whole point: the bot
# wallet's key sits in this file on an internet-facing box, and without this the
# dev cut piles up there indefinitely. With it set, the server wallet only ever
# holds gas plus the cut of the cycle currently in flight.
#
# Blank leaves the dev cut in the signing wallet — which is the right setting
# when that wallet is already yours, and the only setting that matters at an
# 80/20 split, where there is no dev cut at all.
# A malformed address is refused at startup, not mid-cycle.
DEV_PAYOUT_ADDRESS=
# Minimum NEKO balance to qualify for the airdrop, in whole tokens.
# Per-wallet weight cap, % of supply (0 = pure pro-rata).
REWARD_CAP_PCT=0
# JSON array of address-groups treated as one wallet for the cap.
CLUSTERS=[]
# Extra excluded owners, comma-separated.
AIRDROP_EXCLUDE=
# Max transfers in flight at once; also recipients per disperse batch.
AIRDROP_BATCH_SIZE=30
# Fixed gas per airdrop transfer (skips a per-tx estimateGas round trip).
AIRDROP_GAS_LIMIT=120000
# ERC-20 batch-transfer contract. Blank -> one pipelined transfer per recipient,
# which is fine at a few hundred holders.
#
# It MUST expose exactly:
#   function disperseToken(address token, address[] recipients, uint256[] values)
# NOTE: pons-launcher/contracts/Disperse.sol is NOT this — that one is native
# ETH only and every batch would revert on an unknown selector.
#
# The approval is handled for you — the bot approves NVDA to this address on the
# first airdrop that uses it.
#
# contracts/TokenDisperser.sol in this repo is exactly this contract. Deploy it
# with:  npm i solc --no-save && node scripts/deploy-disperser.js --confirm
DISPERSE_ADDRESS=

# Gas is NOT self-funding here: the dev cut is NVDA while gas is ETH, so the
# wallet cannot refill itself from what it collects. Below this ETH balance a
# cycle refuses to START, rather than claiming and then failing to pay anyone.
GAS_RESERVE_ETH=0.01

# ── pons v2 wiring (verified on chain; override only if pons redeploys) ──────
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
BUYBACK_VAULT=0x42df2a798f82289E177311362e8f5ccC45c1219c
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# ── Storage ──────────────────────────────────────────────────────────────────
# Both processes share this database: the bot writes payouts, the API reads them.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=artificialneko

# ── Caching ──────────────────────────────────────────────────────────────────
# How long a fetched value is served before refreshing, in ms. Every visitor's
# browser polls, so these are what keep the upstreams from seeing one request
# per visitor.
MARKET_TTL_MS=30000
HOLDERS_TTL_MS=120000
REWARDS_TTL_MS=60000
FEED_TTL_MS=30000

# ── Security ─────────────────────────────────────────────────────────────────
# Protects the bot's operator endpoints (/status, /run, /pause, /resume).
# Blank leaves them open — acceptable only because they bind to localhost.
# Set a long random string in production: openssl rand -hex 32
API_KEY=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins that may call the API. Must
# include the scheme. Use "*" to allow any origin (not recommended).
# Non-browser calls (curl, uptime checks) always pass.
CORS_ORIGINS=https://artificialneko.com,https://www.artificialneko.com

# ── Artificial Neko specifics ──────────────────────────────────────────
# The QUOTE asset: what pons pays creator fees in. Verified NVDA on chain 4663.
# At least five impostors exist, some sharing the name and symbol - the bot
# refuses to start unless the bytecode matches a genuine tokenized stock.
QUOTE_TOKEN_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
QUOTE_SYMBOL=NVDA

# The REWARD asset: what holders are paid. Here it is the SAME token the fees
# arrive in, so the cycle's buy step is a no-op - there is nothing to swap.
# Point this at a different token and the buy leg switches on by itself.
REWARD_TOKEN_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
REWARD_SYMBOL=NVDA
# Unused while the reward IS the quote asset - kept so switching to a bought
# reward token later is a config change rather than a code change.
REWARD_POOL_FEE=8388608
REWARD_POOL_TICK_SPACING=8
REWARD_POOL_HOOKS=0x4e3468951D49f2EEa976eD0D6e75fFCb44a9a544

# Both hooked pools reject an ERC-20 input through the UniversalRouter, so the
# reward buy and the buyback both route through our own PoolManager router.
V4_BUYER_ADDRESS=0x5FCe84D38DD7707AC58bf8277859b384aa2158E8

# Gas and the dev cut need native ETH, and NVDA has NO native-ETH v4 pool.
# The route is Uniswap v3 to WETH, then unwrap.
V3_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
GAS_POOL_FEE=500

# ── Holder list: from the chain, or from the explorer ────────────────────────
# The airdrop needs every holder and balance. Blockscout pages 50 at a time, so
# a token with 2,000 holders is ~40 sequential requests through a shared public
# service — which has answered one page in 18 seconds, returned 504 four times
# running, and hung long enough to wedge a whole cycle.
#
# Set this to the block the token was DEPLOYED in and the bot derives holders
# from Transfer logs on your own RPC instead. Measured on NEKO: 33,412 transfers
# over 559,133 blocks in 20s for the first build, then 2.7s per cycle.
#
# Balances are checked against totalSupply() every time. A wrong start block
# misses the mint, the sums disagree, and the index refuses itself and falls
# back to the explorer rather than paying against a list that does not add up.
#
# 0 = disabled, explorer only (the old behaviour).
HOLDER_INDEX_FROM_BLOCK=0
# Blocks per getLogs call. Providers cap this and disagree: QuickNode refuses
# anything over 10,000 with a 413, the public RPC allows 50,000. 9,000 works on
# both; raise it if your provider is generous.
HOLDER_INDEX_CHUNK=9000

# What the site advertises: 100,000 NEKO to qualify for a payout.
MIN_HOLD=100000

# The claim splits four ways. These three are set here; the DEV cut is whatever
# is left, so at 90/0/10 there is none and every NVDA either reaches a holder or
# pays for the gas that delivers it.
#
# BURN_PCT is 0 BY CHOICE. This deployment pays holders as much as it can rather
# than spending a quarter of every claim buying its own token back. The buyback
# code is intact and tested — it is just not funded, and each cycle logs
# "burn share of this claim is zero" and carries on. To switch it on, give
# BURN_PCT a share and take the same amount off REWARD_PCT. Nothing else changes.
REWARD_PCT=90
BURN_PCT=0
GAS_PCT=10
